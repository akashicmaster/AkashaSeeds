    },
    "plants": {
      "paths": [
        "assets/plants_checklist/",
        "assets/plants_vision/",
        "assets/plants_vision20/",
        "config/tier_policy.json"
      ],
      "whole": true
    },
    "station": {
      "paths": [
        "config/workbench/workloads/news_show.json",
