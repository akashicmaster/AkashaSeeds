# Akasha ontology — Philosophy World: the repères, the conceptual distinctions of the French
# Baccalauréat. A second axis to the notions: the "tools of thought" — paired concepts a student
# must be able to wield. Each is one phil:repere:* atom stating the distinction, with a wp:<Title>
# Wikipedia exit and membership in phil:reperes. English + French. No new namespace/relation.

def "phil:repere:absolu_relatif" "Absolute / Relative (absolu / relatif) — the absolute holds independently of anything else; the relative holds only in relation to something (a viewpoint, a measure, a context)."
al phil:repere:absolu_relatif wp:Relativism
ln phil:repere:absolu_relatif phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:absolu_relatif"

def "phil:repere:abstrait_concret" "Abstract / Concrete (abstrait / concret) — the abstract is separated from experience by thought (a number, justice); the concrete is the individual thing given in experience."
al phil:repere:abstrait_concret wp:Abstract_and_concrete
ln phil:repere:abstrait_concret phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:abstrait_concret"

def "phil:repere:acte_puissance" "Actuality / Potentiality (en acte / en puissance) — Aristotle's pair: what a thing actually is now, versus what it has the power to become (the acorn is a tree in potentiality)."
al phil:repere:acte_puissance wp:Potentiality_and_actuality
ln phil:repere:acte_puissance phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:acte_puissance"

def "phil:repere:analyse_synthese" "Analysis / Synthesis (analyse / synthèse) — analysis decomposes a whole into its elements; synthesis composes elements into a whole. Also: judgments that unfold a concept versus those that add to it."
al phil:repere:analyse_synthese wp:Analytic–synthetic_distinction
ln phil:repere:analyse_synthese phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:analyse_synthese"

def "phil:repere:contingent_necessaire" "Contingent / Necessary (contingent / nécessaire) — the necessary could not be otherwise; the contingent could have been otherwise, and depends on conditions."
al phil:repere:contingent_necessaire wp:Contingency_(philosophy)
ln phil:repere:contingent_necessaire phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:contingent_necessaire"

def "phil:repere:croire_savoir" "To believe / To know (croire / savoir) — belief holds a proposition as true without sufficient proof; knowledge is a belief that is true and justified."
al phil:repere:croire_savoir wp:Knowledge
ln phil:repere:croire_savoir phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:croire_savoir"

def "phil:repere:essentiel_accidentel" "Essential / Accidental (essentiel / accidentel) — the essential belongs to what a thing is and cannot be removed without destroying it; the accidental could change while the thing remains itself."
al phil:repere:essentiel_accidentel wp:Essence
ln phil:repere:essentiel_accidentel phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:essentiel_accidentel"

def "phil:repere:exemple_preuve" "Example / Proof (exemple / preuve) — an example illustrates and suggests; a proof establishes a conclusion with necessity. One example cannot prove a universal claim, though one counter-example can refute it."
al phil:repere:exemple_preuve wp:Evidence
ln phil:repere:exemple_preuve phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:exemple_preuve"

def "phil:repere:expliquer_comprendre" "To explain / To understand (expliquer / comprendre) — to explain is to relate a phenomenon to its causes and laws (the natural sciences); to understand is to grasp the meaning of a human act from within (the human sciences)."
al phil:repere:expliquer_comprendre wp:Verstehen
ln phil:repere:expliquer_comprendre phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:expliquer_comprendre"

def "phil:repere:fait_droit" "In fact / By right (en fait / en droit) — what is actually the case, versus what ought to be or is legitimate in principle. A question of fact is settled by observation; a question of right, by justification."
al phil:repere:fait_droit wp:De_facto
ln phil:repere:fait_droit phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:fait_droit"

def "phil:repere:formel_materiel" "Formal / Material (formel / matériel) — the form is the structure or arrangement; the matter is what is arranged. A valid argument is correct in form whatever its content."
al phil:repere:formel_materiel wp:Hylomorphism
ln phil:repere:formel_materiel phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:formel_materiel"

def "phil:repere:genre_espece_individu" "Genus / Species / Individual (genre / espèce / individu) — the ladder of generality: the genus (animal) divides into species (human) which are realised in individuals (this person)."
al phil:repere:genre_espece_individu wp:Genus–differentia_definition
ln phil:repere:genre_espece_individu phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:genre_espece_individu"

def "phil:repere:hypothese_consequence_conclusion" "Hypothesis / Consequence / Conclusion (hypothèse / conséquence / conclusion) — a hypothesis is supposed in order to test it; consequences are what follow if it holds; a conclusion is affirmed as established by the reasoning."
al phil:repere:hypothese_consequence_conclusion wp:Hypothesis
ln phil:repere:hypothese_consequence_conclusion phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:hypothese_consequence_conclusion"

def "phil:repere:ideal_reel" "Ideal / Real (idéal / réel) — the ideal exists as thought, model or norm; the real exists in fact. The ideal can guide or judge the real without being realised."
al phil:repere:ideal_reel wp:Idealism
ln phil:repere:ideal_reel phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:ideal_reel"

def "phil:repere:identite_egalite_difference" "Identity / Equality / Difference (identité / égalité / différence) — identity is being the same thing; equality is sharing a measure or value while remaining distinct; difference is what sets things apart."
al phil:repere:identite_egalite_difference wp:Identity_(philosophy)
ln phil:repere:identite_egalite_difference phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:identite_egalite_difference"

def "phil:repere:impossible_possible" "Impossible / Possible (impossible / possible) — the possible can be without contradiction; the impossible cannot be at all. Between them lie degrees of the probable."
al phil:repere:impossible_possible wp:Modal_logic
ln phil:repere:impossible_possible phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:impossible_possible"

def "phil:repere:intuitif_discursif" "Intuitive / Discursive (intuitif / discursif) — intuitive knowledge grasps its object immediately, at a glance; discursive knowledge proceeds step by step through reasoning."
al phil:repere:intuitif_discursif wp:Intuition
ln phil:repere:intuitif_discursif phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:intuitif_discursif"

def "phil:repere:legal_legitime" "Legal / Legitimate (légal / légitime) — the legal conforms to the law in force; the legitimate conforms to justice or right. An unjust law is legal but not legitimate."
al phil:repere:legal_legitime wp:Legitimacy_(political)
ln phil:repere:legal_legitime phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:legal_legitime"

def "phil:repere:mediat_immediat" "Mediate / Immediate (médiat / immédiat) — the immediate is grasped directly, without an intermediary; the mediate is reached through a middle term, a means or a process."
al phil:repere:mediat_immediat wp:Immediate_inference
ln phil:repere:mediat_immediat phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:mediat_immediat"

def "phil:repere:objectif_subjectif" "Objective / Subjective (objectif / subjectif / intersubjectif) — the objective holds of the object, valid for all; the subjective belongs to the experiencing subject; the intersubjective is what several subjects can share and agree on."
al phil:repere:objectif_subjectif wp:Objectivity_(philosophy)
ln phil:repere:objectif_subjectif phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:objectif_subjectif"

def "phil:repere:obligation_contrainte" "Obligation / Constraint (obligation / contrainte) — an obligation binds from within, through duty one recognises; a constraint forces from without, by physical or social compulsion. One can resist a constraint; one owes an obligation."
al phil:repere:obligation_contrainte wp:Obligation
ln phil:repere:obligation_contrainte phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:obligation_contrainte"

def "phil:repere:origine_fondement" "Origin / Foundation (origine / fondement) — the origin is where something begins in time; the foundation is what justifies or grounds it in reason. The origin of morality is not its foundation."
al phil:repere:origine_fondement wp:Foundationalism
ln phil:repere:origine_fondement phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:origine_fondement"

def "phil:repere:persuader_convaincre" "To persuade / To convince (persuader / convaincre) — to persuade is to win assent by any means, including feeling (rhetoric); to convince is to compel assent by reasons alone."
al phil:repere:persuader_convaincre wp:Rhetoric
ln phil:repere:persuader_convaincre phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:persuader_convaincre"

def "phil:repere:principe_cause_fin" "Principle / Cause / End (principe / cause / fin) — a principle is a starting point of reasoning or being; a cause produces an effect; an end (final cause) is that for the sake of which something is done."
al phil:repere:principe_cause_fin wp:Four_causes
ln phil:repere:principe_cause_fin phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:principe_cause_fin"

def "phil:repere:public_prive" "Public / Private (public / privé) — the public concerns the community and its common affairs, open to all; the private concerns the individual and the intimate, withdrawn from the common gaze."
al phil:repere:public_prive wp:Public_sphere
ln phil:repere:public_prive phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:public_prive"

def "phil:repere:ressemblance_analogie" "Resemblance / Analogy (ressemblance / analogie) — resemblance is a shared quality between things; analogy is a shared relation (A is to B as C is to D), which can hold between things that do not resemble each other."
al phil:repere:ressemblance_analogie wp:Analogy
ln phil:repere:ressemblance_analogie phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:ressemblance_analogie"

def "phil:repere:theorie_pratique" "Theory / Practice (théorie / pratique) — theory is knowledge for its own sake, contemplation of what is; practice is action that transforms the world. The question is how the two inform each other (praxis)."
al phil:repere:theorie_pratique wp:Praxis_(process)
ln phil:repere:theorie_pratique phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:theorie_pratique"

def "phil:repere:transcendant_immanent" "Transcendent / Immanent (transcendant / immanent) — the transcendent lies beyond a domain and surpasses it (a God beyond the world); the immanent remains within it (an order internal to nature or mind)."
al phil:repere:transcendant_immanent wp:Transcendence_(philosophy)
ln phil:repere:transcendant_immanent phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:transcendant_immanent"

def "phil:repere:universel_singulier" "Universal / General / Particular / Singular (universel / général / particulier / singulier) — the universal holds of all without exception; the general of most; the particular of some; the singular of one alone."
al phil:repere:universel_singulier wp:Universal_(metaphysics)
ln phil:repere:universel_singulier phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:universel_singulier"

def "phil:repere:vrai_probable_certain" "True / Probable / Certain (vrai / probable / certain) — the true matches what is; the certain is the subjective state of holding something beyond doubt; the probable stands between, supported but not established. The certain is not always true."
al phil:repere:vrai_probable_certain wp:Certainty
ln phil:repere:vrai_probable_certain phil:philosophy sys:part_of
set.add name="phil:reperes" id="phil:repere:vrai_probable_certain"
