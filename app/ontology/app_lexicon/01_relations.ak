def "reldef:vis:compares" "compares — the source model-comparison record compares the two target observations (the difference between observers is first-class research data, not noise)."
set.add name="rels" id="reldef:vis:compares"
def "reldef:vis:derived_from" "derived from — the source derived feature observation (e.g. the lightweight Color⊕Geometry⊕Texture vector) is assembled from the target originating observation; the originating observations are never erased (an analytical derivative, not a source fact)."
set.add name="rels" id="reldef:vis:derived_from"
def "reldef:vis:embedding_ref" "embedding ref — the source feature observation references the target stored embedding (large vectors live in the tensor store, never inlined in the atom)."
set.add name="rels" id="reldef:vis:embedding_ref"
def "reldef:vis:in_run" "in run — the source observation belongs to the target vision run (the reproducible experiment execution that recorded it)."
set.add name="rels" id="reldef:vis:in_run"
def "reldef:vis:observer" "observer — the source observation was produced by the target immutable model identity (family/variant/version/weights/thresholds). A new model or config is a new observation, never an overwrite."
set.add name="rels" id="reldef:vis:observer"
def "reldef:vis:observes" "observes — the source machine OBSERVATION (or detection) observes the target artwork Source Atom. A machine observation is never an artwork property: the observer, model version, and confidence stay attached, and the Source Atom is never mutated."
set.add name="rels" id="reldef:vis:observes"
def "reldef:work:belong_via" "work belong via — work relation (work belong via)."
set.add name="rels" id="reldef:work:belong_via"
