set.add name="rels" id="reldef:thesaurus:hypernym"
def "reldef:thesaurus:hyponym" "hyponym — the target is a narrower kind of the source (is-a downward)."
set.add name="rels" id="reldef:thesaurus:hyponym"
def "reldef:thesaurus:near_synonym" "near synonym — the two words are close in sense without being interchangeable; weaker than `thesaurus:synonym` and asserted where a shade of difference matters."
