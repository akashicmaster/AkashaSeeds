def "gen:locus:cs_indriya" "Indriyasthāna · Caraka Saṃhitā"
set.add name="gen:work:caraka_samhita:loci" id="gen:locus:cs_indriya"
ln gen:locus:cs_indriya gen:work:caraka_samhita @in_work
ln gen:locus:cs_indriya gen:layer:cs_caraka_core @in_layer
