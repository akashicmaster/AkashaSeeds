# Genealogy — the Ayurveda corpus (Caraka & Suśruta stratification + the source-stemma).
# Namespace gen:. Companion: app/concepts/gen.py (the SUPERSET model; sty is its subset). Generated by scripts/gen_genealogy_ayurveda_ak.py.
# Matrix streamed at runtime: io.ingest model=gen into=<work> path=app/ontology/base3/genealogy_ayurveda_matrix.jsonl
# Work-scoped atoms carry ' · <work>' in their content (content-addressing disambiguation).

# ── measurement lenses (feature spaces) ──
def "gen:lens:stylometry" "Stylometry lens — one feature space over the loci."
set.add name="gen:lenses" id="gen:lens:stylometry"
def "gen:lens:attestation" "Attestation lens — one feature space over the loci."
set.add name="gen:lenses" id="gen:lens:attestation"
def "gen:lens:chronology" "Chronology lens — one feature space over the loci."
set.add name="gen:lenses" id="gen:lens:chronology"
def "gen:lens:geography" "Geography lens — one feature space over the loci."
set.add name="gen:lenses" id="gen:lens:geography"
def "gen:lens:concept" "Concept lens — one feature space over the loci."
set.add name="gen:lenses" id="gen:lens:concept"
def "gen:lens:botany" "Botany lens — one feature space over the loci."
set.add name="gen:lenses" id="gen:lens:botany"
def "gen:lens:tradition" "Tradition lens — one feature space over the loci."
set.add name="gen:lenses" id="gen:lens:tradition"

# ── the source-stemma (genealogy nodes) ──
def "gen:work:atharvaveda" "Atharvaveda — The Vedic hymns of healing (bhaiṣajyāni) — the pre-classical root of Indian medicine."
set.add name="gen:works" id="gen:work:atharvaveda"
ln gen:work:atharvaveda ancient:vedic thesaurus:related
ln gen:work:atharvaveda tradition:ayurveda thesaurus:related
def "gen:work:agnivesha_tantra" "Agniveśa-tantra — The lost ur-text of the Ātreya school, the base Caraka redacted."
set.add name="gen:works" id="gen:work:agnivesha_tantra"
ln gen:work:agnivesha_tantra gen:work:atharvaveda @derives_from
ln gen:work:agnivesha_tantra tradition:ayurveda thesaurus:related
def "gen:work:astangahrdaya" "Aṣṭāṅgahṛdaya (Vāgbhaṭa) — Vāgbhaṭa's synthesis (c. 7th c.) — the confluence of the Caraka and Suśruta streams."
set.add name="gen:works" id="gen:work:astangahrdaya"
ln gen:work:astangahrdaya gen:work:caraka_samhita @derives_from
ln gen:work:astangahrdaya gen:work:susruta_samhita @derives_from
ln gen:work:astangahrdaya tradition:ayurveda thesaurus:related

# ══ Caraka Saṃhitā ══
def "gen:work:caraka_samhita" "Caraka Saṃhitā — the Ātreya-school compendium"
set.add name="gen:works" id="gen:work:caraka_samhita"
ln gen:work:caraka_samhita gen:work:agnivesha_tantra @derives_from
ln gen:work:caraka_samhita tradition:ayurveda thesaurus:related
ln gen:work:caraka_samhita textcrit:recension thesaurus:related
ln gen:work:caraka_samhita textcrit:interpolation thesaurus:related
def "gen:witness:caraka_pali_ed" "The vulgate Sanskrit text (Yādavaśarman ed.)"
set.add name="gen:work:caraka_samhita:witnesses" id="gen:witness:caraka_pali_ed"
ln gen:witness:caraka_pali_ed gen:work:caraka_samhita @witness_of
def "gen:witness:caraka_tibetan" "The Tibetan Tanjur version"
set.add name="gen:work:caraka_samhita:witnesses" id="gen:witness:caraka_tibetan"
ln gen:witness:caraka_tibetan gen:work:caraka_samhita @witness_of
def "gen:layer:cs_caraka_core" "Caraka's redaction (Ātreya–Agniveśa core) — The five-and-a-half sthānas transmitted from Agniveśa and redacted by Caraka."
set.add name="gen:work:caraka_samhita:layers" id="gen:layer:cs_caraka_core"
ln gen:layer:cs_caraka_core gen:work:caraka_samhita @in_work
def "gen:layer:cs_dridhabala" "Dṛḍhabala's supplement — The final ~third (Cikitsā XIV–XXX, Kalpa, Siddhi), supplied by Dṛḍhabala (c. 4th–5th c.)."
set.add name="gen:work:caraka_samhita:layers" id="gen:layer:cs_dridhabala"
ln gen:layer:cs_dridhabala gen:work:caraka_samhita @in_work
def "gen:locus:cs_sutra" "Sūtrasthāna · Caraka Saṃhitā"
set.add name="gen:work:caraka_samhita:loci" id="gen:locus:cs_sutra"
ln gen:locus:cs_sutra gen:work:caraka_samhita @in_work
ln gen:locus:cs_sutra gen:layer:cs_caraka_core @in_layer
ln gen:locus:cs_sutra gen:witness:caraka_pali_ed @attested_in
ln gen:locus:cs_sutra gen:witness:caraka_tibetan @attested_in
def "gen:locus:cs_nidana" "Nidānasthāna · Caraka Saṃhitā"
set.add name="gen:work:caraka_samhita:loci" id="gen:locus:cs_nidana"
ln gen:locus:cs_nidana gen:work:caraka_samhita @in_work
ln gen:locus:cs_nidana gen:layer:cs_caraka_core @in_layer
ln gen:locus:cs_nidana gen:witness:caraka_pali_ed @attested_in
ln gen:locus:cs_nidana gen:witness:caraka_tibetan @attested_in
ln gen:locus:cs_sutra gen:locus:cs_nidana @next_locus
def "gen:locus:cs_vimana" "Vimānasthāna · Caraka Saṃhitā"
set.add name="gen:work:caraka_samhita:loci" id="gen:locus:cs_vimana"
ln gen:locus:cs_vimana gen:work:caraka_samhita @in_work
