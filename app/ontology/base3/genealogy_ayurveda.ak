def "gen:locus:cs_cikitsa_a" "Cikitsāsthāna I–XIII · Caraka Saṃhitā"
set.add name="gen:work:caraka_samhita:loci" id="gen:locus:cs_cikitsa_a"
ln gen:locus:cs_cikitsa_a gen:work:caraka_samhita @in_work
