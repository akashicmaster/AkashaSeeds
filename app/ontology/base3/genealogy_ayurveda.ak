set.add name="gen:features" id="gen:feature:ss_ophthalmic_density"
ln gen:feature:ss_ophthalmic_density gen:lens:stylometry @via_lens
def "gen:feature:ss_meter_regularity" "Metre regularity · Suśruta Saṃhitā — Regularity of the śloka metre."
set.add name="gen:features" id="gen:feature:ss_meter_regularity"
ln gen:feature:ss_meter_regularity gen:lens:stylometry @via_lens
def "gen:feature:ss_parallel_attest" "Parallel attestation · Suśruta Saṃhitā — External parallel present: 1 core, 0 Uttaratantra."
set.add name="gen:features" id="gen:feature:ss_parallel_attest"
ln gen:feature:ss_parallel_attest gen:lens:attestation @via_lens
def "gen:feature:ss_date_ce" "Composition date (CE) · Suśruta Saṃhitā — Estimated century of the stratum, CE."
set.add name="gen:features" id="gen:feature:ss_date_ce"
ln gen:feature:ss_date_ce gen:lens:chronology @via_lens
def "gen:feature:ss_region_lon" "Region (longitude °E) · Suśruta Saṃhitā — Approx. longitude of composition — broadly north Indian."
set.add name="gen:features" id="gen:feature:ss_region_lon"
ln gen:feature:ss_region_lon gen:lens:geography @via_lens
def "gen:feature:ss_doctrine_novelty" "Doctrinal novelty · Suśruta Saṃhitā — Density of newly-introduced doctrine / topics."
set.add name="gen:features" id="gen:feature:ss_doctrine_novelty"
ln gen:feature:ss_doctrine_novelty gen:lens:concept @via_lens
def "gen:feature:ss_materia_medica" "Materia-medica density · Suśruta Saṃhitā — Density of named plant-drug material (dravya)."
set.add name="gen:features" id="gen:feature:ss_materia_medica"
ln gen:feature:ss_materia_medica gen:lens:botany @via_lens
def "gen:feature:ss_lineage" "Transmission lineage · Suśruta Saṃhitā — The teaching lineage (Dhanvantari core = 1, Uttaratantra = 0)."
set.add name="gen:features" id="gen:feature:ss_lineage"
ln gen:feature:ss_lineage gen:lens:tradition @via_lens
def "gen:seam:ss_uttara_seam" "Core ▸ Uttaratantra — where the appended supplement begins."
set.add name="gen:work:susruta_samhita:seams" id="gen:seam:ss_uttara_seam"
ln gen:seam:ss_uttara_seam gen:locus:ss_kalpa @seam_after
ln gen:seam:ss_uttara_seam gen:work:susruta_samhita @in_work
def "gen:hyp:ss_later" "The Uttaratantra is a later addition (mainstream) — The five original sthānas form the surgical treatise; the Uttaratantra is a later supplement of distinct topics and doctrine."
set.add name="gen:work:susruta_samhita:hyps" id="gen:hyp:ss_later"
ln gen:hyp:ss_later gen:work:susruta_samhita @in_work
ln gen:hyp:ss_later gen:seam:ss_uttara_seam @posits_seam
ln gen:hyp:ss_later gen:layer:ss_core @groups_layer
ln gen:hyp:ss_later gen:layer:ss_uttara @groups_layer
def "gen:hyp:ss_unitary" "Substantially unified — A minority view: the Uttaratantra belongs to the original design."
set.add name="gen:work:susruta_samhita:hyps" id="gen:hyp:ss_unitary"
ln gen:hyp:ss_unitary gen:work:susruta_samhita @in_work

# ── the published sources ──
def "gen:source:meulenbeld_himl" "A History of Indian Medical Literature (HIML) — G. Jan Meulenbeld · 1999. vol. IA–IIB (1999–2002) — the definitive dating & authorship study"
set.add name="gen:sources" id="gen:source:meulenbeld_himl"
ln gen:source:meulenbeld_himl gen:hyp:cs_third @supports_hyp
ln gen:source:meulenbeld_himl gen:hyp:ss_later @supports_hyp
ln gen:source:meulenbeld_himl gen:hyp:cs_unitary @contests_hyp
ln gen:source:meulenbeld_himl gen:hyp:ss_unitary @contests_hyp
def "gen:source:dridhabala_colophon" "Dṛḍhabala's colophon verse — Dṛḍhabala · c. 400. Siddhisthāna, closing verses — the redactor names his supplement"
set.add name="gen:sources" id="gen:source:dridhabala_colophon"
ln gen:source:dridhabala_colophon gen:hyp:cs_third @supports_hyp
def "gen:source:sharma_dash" "Caraka Saṃhitā (text · translation · notes) — R.K. Sharma & Bhagwan Dash · 1976. Chowkhamba, with critical notes on the strata"
