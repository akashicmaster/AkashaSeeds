def "gen:locus:cs_cikitsa_b" "Cikitsāsthāna XIV–XXX · Caraka Saṃhitā"
set.add name="gen:work:caraka_samhita:loci" id="gen:locus:cs_cikitsa_b"
ln gen:locus:cs_cikitsa_b gen:work:caraka_samhita @in_work
ln gen:locus:cs_cikitsa_b gen:layer:cs_dridhabala @in_layer
ln gen:locus:cs_cikitsa_b gen:witness:caraka_pali_ed @attested_in
ln gen:locus:cs_cikitsa_a gen:locus:cs_cikitsa_b @next_locus
def "gen:locus:cs_kalpa" "Kalpasthāna · Caraka Saṃhitā"
set.add name="gen:work:caraka_samhita:loci" id="gen:locus:cs_kalpa"
ln gen:locus:cs_kalpa gen:work:caraka_samhita @in_work
ln gen:locus:cs_kalpa gen:layer:cs_dridhabala @in_layer
ln gen:locus:cs_kalpa gen:witness:caraka_pali_ed @attested_in
