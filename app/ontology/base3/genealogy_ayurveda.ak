def "gen:feature:cs_lexical_richness" "Lexical richness · Caraka Saṃhitā — Moving-average type–token ratio."
set.add name="gen:features" id="gen:feature:cs_lexical_richness"
ln gen:feature:cs_lexical_richness gen:lens:stylometry @via_lens
def "gen:feature:cs_verse_ratio" "Verse:prose ratio · Caraka Saṃhitā — Share of the section in metrical verse (Dṛḍhabala versifies more)."
set.add name="gen:features" id="gen:feature:cs_verse_ratio"
ln gen:feature:cs_verse_ratio gen:lens:stylometry @via_lens
def "gen:feature:cs_colophon_selfref" "Colophon self-reference · Caraka Saṃhitā — Rate of redactor self-naming / restoration formulae."
set.add name="gen:features" id="gen:feature:cs_colophon_selfref"
ln gen:feature:cs_colophon_selfref gen:lens:stylometry @via_lens
def "gen:feature:cs_term_density" "Technical-term density · Caraka Saṃhitā — Density of nosological / pharmacological technical terms."
set.add name="gen:features" id="gen:feature:cs_term_density"
ln gen:feature:cs_term_density gen:lens:stylometry @via_lens
def "gen:feature:cs_meter_regularity" "Metre regularity · Caraka Saṃhitā — Regularity of the śloka metre."
set.add name="gen:features" id="gen:feature:cs_meter_regularity"
ln gen:feature:cs_meter_regularity gen:lens:stylometry @via_lens
def "gen:feature:cs_parallel_attest" "Parallel attestation · Caraka Saṃhitā — External parallel present (Tibetan / early quotation): 1 core, 0 supplement."
set.add name="gen:features" id="gen:feature:cs_parallel_attest"
ln gen:feature:cs_parallel_attest gen:lens:attestation @via_lens
def "gen:feature:cs_date_ce" "Composition date (CE) · Caraka Saṃhitā — Estimated century of the stratum, CE (Caraka's redaction vs Dṛḍhabala's supplement)."
set.add name="gen:features" id="gen:feature:cs_date_ce"
ln gen:feature:cs_date_ce gen:lens:chronology @via_lens
def "gen:feature:cs_region_lon" "Region (longitude °E) · Caraka Saṃhitā — Approx. longitude of composition — both strata are north-west Indian (≈ 75–76 °E)."
set.add name="gen:features" id="gen:feature:cs_region_lon"
ln gen:feature:cs_region_lon gen:lens:geography @via_lens
def "gen:feature:cs_doctrine_novelty" "Doctrinal novelty · Caraka Saṃhitā — Density of newly-introduced doctrine / technical concepts (via thesaurus drift)."
set.add name="gen:features" id="gen:feature:cs_doctrine_novelty"
ln gen:feature:cs_doctrine_novelty gen:lens:concept @via_lens
def "gen:feature:cs_materia_medica" "Materia-medica density · Caraka Saṃhitā — Density of named plant-drug material (dravya) — the botanical signal, beyond the words."
set.add name="gen:features" id="gen:feature:cs_materia_medica"
ln gen:feature:cs_materia_medica gen:lens:botany @via_lens
def "gen:feature:cs_lineage" "Transmission lineage · Caraka Saṃhitā — The teaching lineage a stratum belongs to (Ātreya–Caraka core = 1, Dṛḍhabala = 0)."
set.add name="gen:features" id="gen:feature:cs_lineage"
ln gen:feature:cs_lineage gen:lens:tradition @via_lens
def "gen:seam:cs_dridhabala_seam" "Core ▸ Dṛḍhabala — where the supplement begins (Cikitsā XIV). The principal join."
set.add name="gen:work:caraka_samhita:seams" id="gen:seam:cs_dridhabala_seam"
ln gen:seam:cs_dridhabala_seam gen:locus:cs_cikitsa_a @seam_after
ln gen:seam:cs_dridhabala_seam gen:work:caraka_samhita @in_work
def "gen:hyp:cs_third" "Dṛḍhabala supplied a third (mainstream) — Dṛḍhabala restored the last seventeen Cikitsā chapters plus the whole Kalpa- and Siddhi-sthānas — about a third of the work."
set.add name="gen:work:caraka_samhita:hyps" id="gen:hyp:cs_third"
ln gen:hyp:cs_third gen:work:caraka_samhita @in_work
ln gen:hyp:cs_third gen:seam:cs_dridhabala_seam @posits_seam
ln gen:hyp:cs_third gen:layer:cs_caraka_core @groups_layer
ln gen:hyp:cs_third gen:layer:cs_dridhabala @groups_layer
def "gen:hyp:cs_minimal" "Only Kalpa and Siddhi restored — A minimal reading: Dṛḍhabala restored only the two lost final sthānas; the Cikitsāsthāna is substantially Caraka's."
set.add name="gen:work:caraka_samhita:hyps" id="gen:hyp:cs_minimal"
ln gen:hyp:cs_minimal gen:work:caraka_samhita @in_work
ln gen:hyp:cs_minimal gen:layer:cs_caraka_core @groups_layer
ln gen:hyp:cs_minimal gen:layer:cs_dridhabala @groups_layer
def "gen:hyp:cs_unitary" "Substantially Caraka's — A minority view: the received text is essentially Caraka's redaction, the Dṛḍhabala note a late colophon."
set.add name="gen:work:caraka_samhita:hyps" id="gen:hyp:cs_unitary"
ln gen:hyp:cs_unitary gen:work:caraka_samhita @in_work

# ══ Suśruta Saṃhitā ══
def "gen:work:susruta_samhita" "Suśruta Saṃhitā — the surgical compendium"
set.add name="gen:works" id="gen:work:susruta_samhita"
ln gen:work:susruta_samhita gen:work:atharvaveda @derives_from
