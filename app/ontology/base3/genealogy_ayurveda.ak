def "gen:locus:cs_sharira" "Śārīrasthāna · Caraka Saṃhitā"
set.add name="gen:work:caraka_samhita:loci" id="gen:locus:cs_sharira"
ln gen:locus:cs_sharira gen:work:caraka_samhita @in_work
ln gen:locus:cs_sharira gen:layer:cs_caraka_core @in_layer
ln gen:locus:cs_sharira gen:witness:caraka_pali_ed @attested_in
ln gen:locus:cs_sharira gen:witness:caraka_tibetan @attested_in
