# Stylometry — the Homeric Iliad stratification catalog (durable form of the /labo/stylometry lab).
# Namespace sty:. Companion code: app/concepts/sty.py (⊂ gen.py). Generated by scripts/gen_stylometry_iliad_ak.py.
# The measurement MATRIX is NOT here — it is streamed at runtime with
#   io.ingest model=sty into=iliad path=app/ontology/base3/stylometry_iliad_matrix.jsonl
# This catalog links out to the existing textanal:/textcrit: vocabulary via thesaurus:related.

def "sty:work:iliad" "Iliad — the Homeric epic (Ancient Greek; 24 books; measured on West's Teubner text)."
set.add name="sty:works" id="sty:work:iliad"
ln sty:work:iliad textanal:stylometry thesaurus:related
ln sty:work:iliad textanal:corpus thesaurus:related
ln sty:work:iliad textcrit:recension thesaurus:related
ln sty:work:iliad textcrit:witness thesaurus:related
ln sty:work:iliad textcrit:interpolation thesaurus:related

# ── witnesses (recensions) ──
def "sty:witness:west_teubner" "Homeri Ilias, ed. M.L. West (Teubner, 1998–2000)"
set.add name="sty:work:iliad:witnesses" id="sty:witness:west_teubner"
ln sty:witness:west_teubner sty:work:iliad @witness_of
def "sty:witness:oct_monro_allen" "Homeri Opera I–II, ed. Monro & Allen (OCT, 3rd ed.)"
set.add name="sty:work:iliad:witnesses" id="sty:witness:oct_monro_allen"
ln sty:witness:oct_monro_allen sty:work:iliad @witness_of

# ── composition strata ──
def "sty:layer:il_main" "Main narrative — The dominant texture of the poem — the wrath and its battle books."
set.add name="sty:work:iliad:layers" id="sty:layer:il_main"
ln sty:layer:il_main sty:work:iliad @in_work
def "sty:layer:il_catalogue" "The Catalogue (Book II) — The Catalogue of Ships — a distinct, name-dense register."
set.add name="sty:work:iliad:layers" id="sty:layer:il_catalogue"
ln sty:layer:il_catalogue sty:work:iliad @in_work
def "sty:layer:il_doloneia" "The Doloneia (Book X) — The night-raid episode, athetised in antiquity as a later insertion."
set.add name="sty:work:iliad:layers" id="sty:layer:il_doloneia"
ln sty:layer:il_doloneia sty:work:iliad @in_work

