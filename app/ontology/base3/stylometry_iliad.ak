# ── stylometric features ──
def "sty:feature:formulaic_density" "Formulaic density — Density of repeated formulaic phrases and epithets (not a marker of age)."
set.add name="sty:features" id="sty:feature:formulaic_density"
def "sty:feature:hapax_ratio" "Hapax ratio — Share of once-occurring word-types."
set.add name="sty:features" id="sty:feature:hapax_ratio"
def "sty:feature:vocabulary_richness" "Vocabulary richness — Length-normalised type–token richness (MATTR-style)."
set.add name="sty:features" id="sty:feature:vocabulary_richness"
def "sty:feature:mean_clause_length" "Mean clause length — Average words per clause (edition-robust; safer than sentence length in Greek)."
set.add name="sty:features" id="sty:feature:mean_clause_length"
def "sty:feature:direct_speech_ratio" "Direct-speech ratio — Share of the book given to direct speech vs narration."
set.add name="sty:features" id="sty:feature:direct_speech_ratio"
def "sty:feature:simile_density" "Simile density — Density of extended (epic) similes."
set.add name="sty:features" id="sty:feature:simile_density"
def "sty:feature:proper_name_density" "Proper-name density — Density of personal and place names (catalogue detector)."
set.add name="sty:features" id="sty:feature:proper_name_density"
ln sty:feature:vocabulary_richness textanal:type_token_ratio thesaurus:related
ln sty:feature:hapax_ratio textanal:hapax_legomenon thesaurus:related

# ── posited composition seams ──
def "sty:seam:il_seam_catalogue" "I ▸ II — the entry into the name-dense Catalogue of Ships."
set.add name="sty:work:iliad:seams" id="sty:seam:il_seam_catalogue"
ln sty:seam:il_seam_catalogue sty:locus:il1 @seam_after
ln sty:seam:il_seam_catalogue sty:work:iliad @in_work
def "sty:seam:il_seam_doloneia_in" "IX ▸ X — into the Doloneia, athetised in antiquity (schol. 'inserted by Peisistratus')."
set.add name="sty:work:iliad:seams" id="sty:seam:il_seam_doloneia_in"
ln sty:seam:il_seam_doloneia_in sty:locus:il9 @seam_after
ln sty:seam:il_seam_doloneia_in sty:work:iliad @in_work
def "sty:seam:il_seam_doloneia_out" "X ▸ XI — back out of the Doloneia to the main battle narrative."
set.add name="sty:work:iliad:seams" id="sty:seam:il_seam_doloneia_out"
ln sty:seam:il_seam_doloneia_out sty:locus:il10 @seam_after
ln sty:seam:il_seam_doloneia_out sty:work:iliad @in_work

# ── competing stratification hypotheses ──
def "sty:hyp:unity" "Substantially Unified — The poem is stylistically heterogeneous but does not require strong compositional stratification — the variation is within one shaping design."
set.add name="sty:work:iliad:hyps" id="sty:hyp:unity"
ln sty:hyp:unity sty:work:iliad @in_work
def "sty:hyp:oral_layering" "Oral-Formulaic Layering — Measured differences reflect oral-compositional practice, performance context, and inherited formulaic material rather than discrete authorship layers."
set.add name="sty:work:iliad:hyps" id="sty:hyp:oral_layering"
ln sty:hyp:oral_layering sty:work:iliad @in_work
ln sty:hyp:oral_layering sty:layer:il_catalogue @groups_layer
ln sty:hyp:oral_layering sty:layer:il_doloneia @groups_layer
def "sty:hyp:stratified" "Multiple-Strata / Editorial Growth — Some sections (the Catalogue, the Doloneia) may represent later incorporation, revision, or compositional strata distinguishable from the dominant texture of the poem."
set.add name="sty:work:iliad:hyps" id="sty:hyp:stratified"
ln sty:hyp:stratified sty:work:iliad @in_work
ln sty:hyp:stratified sty:seam:il_seam_catalogue @posits_seam
ln sty:hyp:stratified sty:seam:il_seam_doloneia_in @posits_seam
ln sty:hyp:stratified sty:seam:il_seam_doloneia_out @posits_seam
ln sty:hyp:stratified sty:layer:il_doloneia @groups_layer
ln sty:hyp:stratified sty:layer:il_catalogue @groups_layer

# ── the published sources ──
def "sty:source:wolf_1795" "Prolegomena ad Homerum — F.A. Wolf · 1795. the founding Analyst statement"
set.add name="sty:sources" id="sty:source:wolf_1795"
ln sty:source:wolf_1795 sty:hyp:stratified @supports_hyp
ln sty:source:wolf_1795 sty:hyp:unity @contests_hyp
def "sty:source:parry_1971" "The Making of Homeric Verse — Milman Parry (ed. A. Parry) · 1971. the oral-formulaic theory"
set.add name="sty:sources" id="sty:source:parry_1971"
ln sty:source:parry_1971 sty:hyp:oral_layering @supports_hyp
ln sty:source:parry_1971 sty:hyp:stratified @contests_hyp
def "sty:source:lord_1960" "The Singer of Tales — Albert B. Lord · 1960. oral composition in performance"
set.add name="sty:sources" id="sty:source:lord_1960"
ln sty:source:lord_1960 sty:hyp:oral_layering @supports_hyp
def "sty:source:kirk_1985" "The Iliad: A Commentary, vol. I — G.S. Kirk · 1985. Cambridge commentary — a monumental design by one main poet"
set.add name="sty:sources" id="sty:source:kirk_1985"
ln sty:source:kirk_1985 sty:hyp:unity @supports_hyp
ln sty:source:kirk_1985 sty:hyp:oral_layering @supports_hyp
def "sty:source:danek_1988" "Studien zur Dolonie — Georg Danek · 1988. on Book X (the Doloneia)"
set.add name="sty:sources" id="sty:source:danek_1988"
ln sty:source:danek_1988 sty:hyp:stratified @supports_hyp
def "sty:source:west_2011" "The Making of the Iliad — M.L. West · 2011. analytic reconstruction; the poet 'P'"
set.add name="sty:sources" id="sty:source:west_2011"
ln sty:source:west_2011 sty:hyp:stratified @supports_hyp
ln sty:source:west_2011 sty:hyp:oral_layering @contests_hyp
def "sty:source:hainsworth_1993" "The Iliad: A Commentary, vol. III (Books 9–12) — Bryan Hainsworth · 1993. on the embassy and the Doloneia"
set.add name="sty:sources" id="sty:source:hainsworth_1993"
ln sty:source:hainsworth_1993 sty:hyp:unity @supports_hyp
ln sty:source:hainsworth_1993 sty:hyp:oral_layering @supports_hyp

