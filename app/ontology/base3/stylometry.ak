# Stylometry — the Milindapañha stratification catalog (durable form of the /labo/stylometry lab).
# Namespace sty:. Companion code: lib/akasha/concepts/sty.py. Generated by scripts/gen_stylometry_ak.py.
# The measurement MATRIX is NOT here — it is streamed at runtime with
#   io.ingest model=sty into=milindapanha path=app/ontology/base3/stylometry_matrix.jsonl
# This catalog links out to the existing textanal:/textcrit: vocabulary via thesaurus:related.

def "sty:work:milindapanha" "Milindapañha — the Questions of King Milinda (Pāli; king Milinda = Menander I, r. c.165–130 BCE)."
set.add name="sty:works" id="sty:work:milindapanha"
ln sty:work:milindapanha textanal:stylometry thesaurus:related
ln sty:work:milindapanha textanal:burrows_delta thesaurus:related
ln sty:work:milindapanha textanal:corpus thesaurus:related
ln sty:work:milindapanha textcrit:recension thesaurus:related
ln sty:work:milindapanha textcrit:witness thesaurus:related
ln sty:work:milindapanha textcrit:interpolation thesaurus:related

# ── witnesses (recensions) ──
def "sty:witness:pali" "Pāli Milindapañha (PTS ed.)"
set.add name="sty:work:milindapanha:witnesses" id="sty:witness:pali"
ln sty:witness:pali sty:work:milindapanha @witness_of
def "sty:witness:chinese_nagasena" "Nāgasenabhikṣusūtra 那先比丘經 (T1670)"
set.add name="sty:work:milindapanha:witnesses" id="sty:witness:chinese_nagasena"
ln sty:witness:chinese_nagasena sty:work:milindapanha @witness_of

# ── composition strata ──
def "sty:layer:core" "The core dialogues — The original *Milindapañha* — the part with a Chinese parallel."
set.add name="sty:work:milindapanha:layers" id="sty:layer:core"
ln sty:layer:core sty:work:milindapanha @in_work
def "sty:layer:additions" "The later additions — Books IV–VII; absent from the Chinese, likely appended in Sri Lanka."
set.add name="sty:work:milindapanha:layers" id="sty:layer:additions"
ln sty:layer:additions sty:work:milindapanha @in_work

# ── loci (books, in reading order) ──
def "sty:locus:b1" "I · Bāhira-kathā (frame)"
set.add name="sty:work:milindapanha:loci" id="sty:locus:b1"
ln sty:locus:b1 sty:work:milindapanha @in_work
ln sty:locus:b1 sty:layer:core @in_layer
ln sty:locus:b1 sty:witness:pali @attested_in
ln sty:locus:b1 sty:witness:chinese_nagasena @attested_in
def "sty:locus:b2" "II · Lakkhaṇa-pañha"
set.add name="sty:work:milindapanha:loci" id="sty:locus:b2"
ln sty:locus:b2 sty:work:milindapanha @in_work
ln sty:locus:b2 sty:layer:core @in_layer
ln sty:locus:b2 sty:witness:pali @attested_in
ln sty:locus:b2 sty:witness:chinese_nagasena @attested_in
ln sty:locus:b1 sty:locus:b2 @next_locus
def "sty:locus:b3" "III · Vimaticchedana-pañha"
set.add name="sty:work:milindapanha:loci" id="sty:locus:b3"
ln sty:locus:b3 sty:work:milindapanha @in_work
ln sty:locus:b3 sty:layer:core @in_layer
ln sty:locus:b3 sty:witness:pali @attested_in
ln sty:locus:b3 sty:witness:chinese_nagasena @attested_in
ln sty:locus:b2 sty:locus:b3 @next_locus
def "sty:locus:b4" "IV · Meṇḍaka-pañha (the dilemmas)"
set.add name="sty:work:milindapanha:loci" id="sty:locus:b4"
ln sty:locus:b4 sty:work:milindapanha @in_work
ln sty:locus:b4 sty:layer:additions @in_layer
ln sty:locus:b4 sty:witness:pali @attested_in
ln sty:locus:b3 sty:locus:b4 @next_locus
def "sty:locus:b5" "V · Anumāna-pañha"
set.add name="sty:work:milindapanha:loci" id="sty:locus:b5"
ln sty:locus:b5 sty:work:milindapanha @in_work
ln sty:locus:b5 sty:layer:additions @in_layer
ln sty:locus:b5 sty:witness:pali @attested_in
ln sty:locus:b4 sty:locus:b5 @next_locus
def "sty:locus:b6" "VI · Dhutaṅga-pañha"
set.add name="sty:work:milindapanha:loci" id="sty:locus:b6"
ln sty:locus:b6 sty:work:milindapanha @in_work
ln sty:locus:b6 sty:layer:additions @in_layer
ln sty:locus:b6 sty:witness:pali @attested_in
ln sty:locus:b5 sty:locus:b6 @next_locus
def "sty:locus:b7" "VII · Opamma-kathā-pañha (similes)"
set.add name="sty:work:milindapanha:loci" id="sty:locus:b7"
ln sty:locus:b7 sty:work:milindapanha @in_work
ln sty:locus:b7 sty:layer:additions @in_layer
ln sty:locus:b7 sty:witness:pali @attested_in
ln sty:locus:b6 sty:locus:b7 @next_locus

# ── stylometric features ──
def "sty:feature:dialogue_marker_rate" "Dialogue-marker rate — Frequency of the Q/A dialogue formulae (bhante Nāgasena …)."
set.add name="sty:features" id="sty:feature:dialogue_marker_rate"
def "sty:feature:dilemma_formula_rate" "Dilemma-formula rate — Frequency of the meṇḍaka 'two-horned question' framing."
set.add name="sty:features" id="sty:feature:dilemma_formula_rate"
def "sty:feature:simile_rate" "Simile density — Rate of explicit similes (opamma)."
set.add name="sty:features" id="sty:feature:simile_rate"
def "sty:feature:avg_sentence_len" "Mean sentence length — Average words per sentence."
set.add name="sty:features" id="sty:feature:avg_sentence_len"
def "sty:feature:mattr" "Vocabulary richness — Moving-average type–token ratio (MATTR)."
set.add name="sty:features" id="sty:feature:mattr"
def "sty:feature:hapax_ratio" "Hapax ratio — Share of once-occurring word-types."
set.add name="sty:features" id="sty:feature:hapax_ratio"
def "sty:feature:attested_in_chinese" "Chinese attestation — 1 if the locus has a Nāgasenabhikṣusūtra parallel, else 0."
set.add name="sty:features" id="sty:feature:attested_in_chinese"
ln sty:feature:mattr textanal:type_token_ratio thesaurus:related
ln sty:feature:hapax_ratio textanal:hapax_legomenon thesaurus:related

# ── posited composition seams ──
def "sty:seam:frame_core" "Frame ▸ core — the secular prologue vs the doctrinal dialogues."
set.add name="sty:work:milindapanha:seams" id="sty:seam:frame_core"
ln sty:seam:frame_core sty:locus:b1 @seam_after
ln sty:seam:frame_core sty:work:milindapanha @in_work
def "sty:seam:core_additions" "Core ▸ additions — the end of the Chinese parallel; the principal join."
set.add name="sty:work:milindapanha:seams" id="sty:seam:core_additions"
ln sty:seam:core_additions sty:locus:b3 @seam_after
ln sty:seam:core_additions sty:work:milindapanha @in_work
def "sty:seam:similes" "A minor join before the similes book (Opamma)."
set.add name="sty:work:milindapanha:seams" id="sty:seam:similes"
ln sty:seam:similes sty:locus:b6 @seam_after
ln sty:seam:similes sty:work:milindapanha @in_work

# ── competing stratification hypotheses ──
def "sty:hyp:two_layer" "Two-layer (mainstream) — Books I–III are the original work translated into Chinese; IV–VII are a later Sinhalese addition. One seam, after Book III."
set.add name="sty:work:milindapanha:hyps" id="sty:hyp:two_layer"
ln sty:hyp:two_layer sty:work:milindapanha @in_work
ln sty:hyp:two_layer sty:seam:core_additions @posits_seam
ln sty:hyp:two_layer sty:layer:core @groups_layer
ln sty:hyp:two_layer sty:layer:additions @groups_layer
def "sty:hyp:three_layer" "Three-layer — A secular frame (I), a core of dialogues (II–III), and the dilemmas and later material (IV–VII). Two seams."
set.add name="sty:work:milindapanha:hyps" id="sty:hyp:three_layer"
ln sty:hyp:three_layer sty:work:milindapanha @in_work
ln sty:hyp:three_layer sty:seam:frame_core @posits_seam
ln sty:hyp:three_layer sty:seam:core_additions @posits_seam
ln sty:hyp:three_layer sty:layer:core @groups_layer
ln sty:hyp:three_layer sty:layer:additions @groups_layer
def "sty:hyp:unitary" "Substantially unified — A minority/traditional view: the work is essentially one composition. No stylometric seam is decisive."
set.add name="sty:work:milindapanha:hyps" id="sty:hyp:unitary"
ln sty:hyp:unitary sty:work:milindapanha @in_work

# ── the published sources ──
def "sty:source:demieville_1924" "Les versions chinoises du Milindapañha — Paul Demiéville · 1924. BEFEO 24 (1924), pp. 1–258"
set.add name="sty:sources" id="sty:source:demieville_1924"
ln sty:source:demieville_1924 sty:hyp:two_layer @supports_hyp
ln sty:source:demieville_1924 sty:hyp:three_layer @supports_hyp
ln sty:source:demieville_1924 sty:hyp:unitary @contests_hyp
def "sty:source:rhys_davids_1890" "The Questions of King Milinda — T.W. Rhys Davids · 1890. Sacred Books of the East 35–36 (1890–94)"
set.add name="sty:sources" id="sty:source:rhys_davids_1890"
ln sty:source:rhys_davids_1890 sty:hyp:two_layer @supports_hyp
def "sty:source:vonhinuber_1996" "A Handbook of Pāli Literature — Oskar von Hinüber · 1996. §172–174"
set.add name="sty:sources" id="sty:source:vonhinuber_1996"
ln sty:source:vonhinuber_1996 sty:hyp:two_layer @supports_hyp
ln sty:source:vonhinuber_1996 sty:hyp:three_layer @supports_hyp
def "sty:source:horner_1963" "Milinda's Questions — I.B. Horner · 1963. PTS translation (1963–64)"
set.add name="sty:sources" id="sty:source:horner_1963"
ln sty:source:horner_1963 sty:hyp:two_layer @supports_hyp
def "sty:source:tarn_1938" "The Greeks in Bactria and India — W.W. Tarn · 1938. on Menander/Milinda (r. c.165–130 BCE)"
set.add name="sty:sources" id="sty:source:tarn_1938"

