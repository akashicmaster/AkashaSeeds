# Runtime output generated by running Akasha from a clone.
# None of these are part of the distributed source tree.

# Core runtime stores and caches
/data/
/logs/
/env/
/assets/
__pycache__/
*.pyc

# Secrets and deployment env
.env
.env.*
/env/deployment.env
/env/secrets.env
/env/models/

# Runtime- and user-owned paths (created on launch; user knowledge persists here)
/app/archives/snapshots/
/apps/custom/
/ontology/user/
/lib/plugins/
/docs/user/
/config/tls.json
