# See docs/for-llm/rel-definition-spec.md. Do not edit by hand; re-run the generator.

def "reldef:agent:as" "as — the source agent acts AS the target cast (the agent's persona side of the cast×society binding)."
set.add name="rels" id="reldef:agent:as"
def "reldef:agent:in" "in — the source agent is an agent IN the target society (the society side of the binding)."
set.add name="rels" id="reldef:agent:in"
def "reldef:agent:state" "state — the source agent's per-workflow state is held on the target state atom (the reserved CSL-state seam: state lives on the agent, not in CSL; keyed by workflow)."
set.add name="rels" id="reldef:agent:state"
def "reldef:bench:superseded_by" "superseded by — the source (new) bench artifact — a model identity, a frozen frame, a metrics atom, or a promotion record — supersedes the target (old) one after a re-train changed the file/corpus; the old atom is retained (immutable per file, reachable for audit) with the alias re-pointed to the new content (A46)."
set.add name="rels" id="reldef:bench:superseded_by"
def "reldef:calc:associated_with" "associated with — a computed or curated association between two atoms."
set.add name="rels" id="reldef:calc:associated_with"
def "reldef:chronon:mutates" "mutates — the source chronon is a variation/derivation of the target chronon (records HOW the state changed, orthogonal to THAT it advanced)."
set.add name="rels" id="reldef:chronon:mutates"
def "reldef:chronon:next" "next — the source chronon is succeeded by the target chronon (temporal succession; forward = future, reverse = past; multiple successors = branches / alternative futures)."
set.add name="rels" id="reldef:chronon:next"
def "reldef:chronon:of" "of — the source chronon belongs to the target society (chronon:<sid>:<id> → society:<sid>)."
set.add name="rels" id="reldef:chronon:of"
def "reldef:cronon:at" "cronon at — the source event atom is located at the target cronon (Akasha-Time position); the cronon does not execute the event."
set.add name="rels" id="reldef:cronon:at"
def "reldef:cronon:executes" "executes — the source WORKBENCH coordinate (mode=execution) carried out the target workflow plan position (the entry key it read); a step's executions are the bench coordinates that execute it (a Set, not a stored list)."
set.add name="rels" id="reldef:cronon:executes"
def "reldef:cronon:follows" "cronon follows — the source cronon is the next Akasha-Time position after the target (a coordinate order, not execution)."
set.add name="rels" id="reldef:cronon:follows"
def "reldef:cronon:forked_from" "forked from — the source workflow branch's first coordinate was forked from the target parent coordinate (wf.branch); the fork link stays on the branch clocks."
set.add name="rels" id="reldef:cronon:forked_from"
def "reldef:cronon:maps_to" "cronon maps to — the source cronon maps to the target external temporal frame (the mapping is external to the cronon; temporal relativity)."
set.add name="rels" id="reldef:cronon:maps_to"
def "reldef:cronon:rehearses" "rehearses — the source WORKBENCH coordinate (mode=thought) rehearsed the target workflow plan position without leaving a footprint (wf.advance mode=thought, a rewind/branch/plan revision); rehearsal is preserved beside execution and stays distinguishable."
set.add name="rels" id="reldef:cronon:rehearses"
def "reldef:cronon:sync" "sync — the source WORLD coordinate is synchronized with the target WORKBENCH coordinate (G4: a link joins world and workbench time only; a workflow/branch coordinate is never synced)."
set.add name="rels" id="reldef:cronon:sync"
def "reldef:deviates_from" "deviates from — the source deviation atom (a fact: actual diverged from plan during an execution) points at the target plan entry it deviated from (B1 §A3)."
set.add name="rels" id="reldef:deviates_from"
def "reldef:evidenced_by" "evidenced by — the source claim atom is evidenced by the target atom (an execution coordinate, an observation, or an evaluation row); a claim's status is derived from whether its evidence resolves and holds (B1 §A6)."
set.add name="rels" id="reldef:evidenced_by"
def "reldef:exec:covers" "covers — the source execution membrane (a dispatched workflow run) covers the target workflow entry atom (§4.7 sync granularity: one exec record over a run of entries)."
set.add name="rels" id="reldef:exec:covers"
def "reldef:lex:bridge" "bridge — the source foreign-language proto-word bridges to the target English proto-word (same lemma/sense): the one interlingual link that lets a non-English atom reuse the English graph's links and sets. Bridge the proto-words only; traversal reuses everything downstream."
set.add name="rels" id="reldef:lex:bridge"
def "reldef:observed_in" "observed in — the source deviation atom was observed in the target execution coordinate (the bench coordinate the divergence happened at; coordinate = Set membership, no cronon:at) (B1 §A3)."
set.add name="rels" id="reldef:observed_in"
