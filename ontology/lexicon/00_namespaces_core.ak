set.add name="namespaces" id="nsdef:rec:color"
def "nsdef:ref" "ref — external references and citations."
set.add name="namespaces" id="nsdef:ref"
def "nsdef:region" "region — geographic and culinary regions."
set.add name="namespaces" id="nsdef:region"
def "nsdef:rel" "rel — relation-declaration namespace (rel:salient marks a relation as salient for a category)."
set.add name="namespaces" id="nsdef:rel"
def "nsdef:reldef" "reldef — relation-definition atoms; reldef:<rel> holds a relation's full-spelling description."
set.add name="namespaces" id="nsdef:reldef"
def "nsdef:responsible" "responsible — the accountability relation an agent bears in a society (責務), separate from the permission role:; responsible:<kind> (chairman/scribe/broadcaster/approve:<step>/exec:<step>) links a society to the agent who holds that duty."
set.add name="namespaces" id="nsdef:responsible"
def "nsdef:role" "role — upper-ontology role of a domain super-concept (role:product 成果物, role:component 構成要素, role:method 製法) in the Product·Component·Method canon."
set.add name="namespaces" id="nsdef:role"
def "nsdef:scenario" "scenario — a prospective chronon sub-network written in advance; the same structure as a chronon record, read in the opposite time. Running it does NOT rewrite a chronon's aspect: it ADDS the aspect:perfective membership to each coordinate it walks, and the aspect:prospective membership taken when the scenario was authored is kept. A coordinate holding both was planned and then occurred; one holding only prospective is still outstanding; one holding only perfective happened unplanned — a difference a field rewritten in place would destroy. See nsdef:aspect."
set.add name="namespaces" id="nsdef:scenario"
def "nsdef:sense" "sense — sensory descriptors."
set.add name="namespaces" id="nsdef:sense"
def "nsdef:site" "site — outward web properties of this deployment (analytics anchors for pages that are not concept atoms themselves)."
set.add name="namespaces" id="nsdef:site"
def "nsdef:society" "society — a virtual dialogue space (avatar-mediated chat) on a group; society:<group>:<name> names a space."
set.add name="namespaces" id="nsdef:society"
def "nsdef:source" "source — the Source Data Layer: externally acquired or directly observed data preserved BEFORE analytical interpretation (Source Atoms, Pools, Streams, Snapshots, acquisition events, interpretation bridges). Concept Labo is one consumer, not its owner. `source:item:*` holds RAW ROWS ONLY (verbatim JSON, NLP-exempt, chronon:next-ordered)."
set.add name="namespaces" id="nsdef:source"
def "nsdef:src" "src — access-analytics referrer/acquisition bucket (pulse:src:<referrer>); a coarse arrival class, never PII."
set.add name="namespaces" id="nsdef:src"
def "nsdef:sys" "sys — built-in structural relations and system atoms."
set.add name="namespaces" id="nsdef:sys"
def "nsdef:thesaurus" "thesaurus — thesaurus relations and cross-references."
set.add name="namespaces" id="nsdef:thesaurus"
def "nsdef:timeframe" "timeframe — an external temporal frame a cronon maps to (timeframe:<frame> — wall_clock, historical, simulation_step, geological, …); the mapping lives outside the cronon (temporal relativity)."
set.add name="namespaces" id="nsdef:timeframe"
def "nsdef:tool" "tool — tools and implements."
set.add name="namespaces" id="nsdef:tool"
def "nsdef:txt" "txt — extracted free-text/natural-language fields lifted from a raw source row at prep time (`txt:<corpus>:<id>:<field>`). Unlike the raw JSON container, txt atoms ARE weavable: the Weaver decomposes them so the corpus's meaning joins the semantic graph."
set.add name="namespaces" id="nsdef:txt"
def "nsdef:valid" "valid — the validity membrane: valid:until:<clock>:<pos> indexes the atoms that expire at position <pos> on <clock>. Once the clock passes <pos> the nightly retention sweep evicts the members from the horizon; the store is never touched (B3 §A8)."
set.add name="namespaces" id="nsdef:valid"
def "nsdef:visit" "visit — access-analytics session bucket (visit:<id>); a within-day pseudonymous grouping of one visitor's events, unrecoverable across days."
set.add name="namespaces" id="nsdef:visit"
def "nsdef:wb" "wb — a WORKBENCH on the shared world: the surface a scheduled workload runs on, whether that workload is a research experiment, a broadcast programme or an operational business process. It is NOT a laboratory with extra steps — one driver serves all three, and what differs between them is the DUTY each declares (wb:duty:continuous | wb:duty:best_effort), not the machinery. wb:<name> names a bench and wb:<name>:hyp|evidence|proof|note|source:<n> its records. A closed bench (created with a group) lives in that society's group engine — member-only (F53 scope:wb:<name>). It also stores a whiteboard's pins (set:wb:whiteboard:<board>:pins) — the storage is the bench's, the vocabulary and the ops are the whiteboard's (nsdef:whiteboard; the op family is whiteboard.*, renamed from wb.* so an op family is not spelled like this namespace)."
set.add name="namespaces" id="nsdef:wb"
def "nsdef:whiteboard" "whiteboard — a NAMED bundle of a client's self-directed state (its pins and its focus), the client's own layer: world-ignorable, dying with the session, and never able to widen an IAM grant. A board IS its pins Set (set:wb:whiteboard:<board>:pins, stored on the Workbench); a pin is a MEMBERSHIP taken at the bench clock, so pinning adds and unpinning ends one, and what a board held at a given moment stays readable. The focus is a coordinate, not a pin: it moves while the pins stay, and switching or recreating a board erases neither. Ops are whiteboard.* (renamed from wb.*, which is the bench namespace)."
set.add name="namespaces" id="nsdef:whiteboard"
def "nsdef:wl" "wl — a WORKLOAD: one scheduled unit of work on a workbench, declared in a single file under config/workbench/workloads/ and read by one driver. wl:workload names the concept, wl:effect|trigger|appetite|budget|pins its declared fields, and wl:state:*/wl:reason:* are a second alias on the state and reason atoms the programme guide already stores as station:* — one atom, two names, so the driver has one vocabulary for a broadcast programme, a research bench and an operational process alike. Every field is also a membership on the workload atom (set:wl:*), which is what makes a declaration inspectable as data."
set.add name="namespaces" id="nsdef:wl"
def "nsdef:word" "word — WordNet-derived vocabulary and proto-words."
set.add name="namespaces" id="nsdef:word"
def "nsdef:word:color" "word:color — colour senses of a word."
set.add name="namespaces" id="nsdef:word:color"
def "nsdef:word:sense" "word:sense — sense descriptors of a word."
set.add name="namespaces" id="nsdef:word:sense"
def "nsdef:workflow" "workflow — a bench's script-and-log in one structure; workflow:<bench> heads it and workflow:<bench>:<branch>:<pos> names one entry (ahead of the cursor = plan, behind = record). A bench-scoped layer distinct from the old CSL wf: definition space."
set.add name="namespaces" id="nsdef:workflow"
