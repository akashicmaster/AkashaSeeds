# Generated by scripts/gen_lexicon.py — relation / namespace definition layer.
# See docs/for-llm/rel-definition-spec.md. Do not edit by hand; re-run the generator.

def "nsdef:admin" "admin — administrative divisions and scale."
set.add name="namespaces" id="nsdef:admin"
def "nsdef:agent" "agent — a cast admitted to a society (the cast×society binding); agent:<gid>:<space>:<cast> is that junction. There is no general agent — always an agent OF a society."
set.add name="namespaces" id="nsdef:agent"
def "nsdef:aspect" "aspect — where a coordinate stands in Akasha Time, held as SET MEMBERSHIP rather than a field: aspect:prospective (authored in advance — a plan or a scenario step) and aspect:perfective (the record: it happened), with set:aspect:prospective / set:aspect:perfective holding the coordinates. Membership is ADDITIVE and never removed — running a scenario adds perfective and keeps prospective, so plan and occurrence are two readable memberships instead of one overwritten value, and where they differ is exactly what a record is for (seeds13 law 2: chronon = PERFECTIVE, scenario = PROSPECTIVE, one structure read in opposite times)."
set.add name="namespaces" id="nsdef:aspect"
def "nsdef:bench" "bench — workbench relations binding a bench's records: bench:references (a Source pool/stream reference, never a copy), bench:about, bench:evidence_for, bench:cites, bench:proves, bench:refers_to."
set.add name="namespaces" id="nsdef:bench"
def "nsdef:broadcast" "broadcast — public-broadcast mirror namespace: a broadcaster mirrors a PUBLIC society feed into the shared nucleus (broadcast:<gid>:<space> timeline, broadcast:msg:* messages) so guests read it with AI disclosure via society.broadcast.live, without group scope."
set.add name="namespaces" id="nsdef:broadcast"
def "nsdef:calc" "calc — computed / curated associations and derived values."
set.add name="namespaces" id="nsdef:calc"
def "nsdef:cap" "cap — a capability a role is OFFERED: cap:<name>@<fingerprint8> names one, the fingerprint being the running seed's content_fingerprint (the P3 identity rule). Membership of set:cap:offered:<society>:<role> is what a role MAY be granted; the grant check decides what it IS granted (offered ≠ granted, B5 §A7)."
set.add name="namespaces" id="nsdef:cap"
def "nsdef:chrono" "chrono — temporal placement (before / after)."
set.add name="namespaces" id="nsdef:chrono"
def "nsdef:chronon" "chronon — a semantic state boundary (意味状態境界) held in the network as links+sets; chronon:<sid>:<id> names one. Its members are meaning-bound references (neither snapshot nor delta); succession + variation of chronons is Akasha Time."
set.add name="namespaces" id="nsdef:chronon"
def "nsdef:claim" "claim — a stated assertion about a bench; claim:<sha8> holds the statement + its maker + the bench coordinate it was made at. Its status (attached / unattached / contradicted) is DERIVED from its evidenced_by evidence, never stored. A guest reads only counts (B1 §A6)."
set.add name="namespaces" id="nsdef:claim"
def "nsdef:color" "color — colour terms and palette."
set.add name="namespaces" id="nsdef:color"
def "nsdef:comparison" "comparison — a model-comparison record (comparison:vision:<obj>:<a>:<b>) between two observers on one artwork: shared/only classes, count/confidence differences, bbox overlap, agreement score. Model disagreement is first-class data, not debugging noise."
set.add name="namespaces" id="nsdef:comparison"
def "nsdef:concept" "concept — abstract concepts."
set.add name="namespaces" id="nsdef:concept"
def "nsdef:cronon" "cronon — a primitive operand: a discrete position/unit in Akasha Time (a COORDINATE, not a scheduler/event/execution step). Execution may synchronize on Akasha Time; Akasha Time executes nothing. External time is an EXTERNAL mapping, not part of the cronon."
set.add name="namespaces" id="nsdef:cronon"
