# sci_hierarchy.ak — a browsable sys:is_a taxonomy over the flat sci: namespace, so the
# archives field navigator (分野別) can show a left hierarchy for the Sciences Room.
# Generated from ontology/base3/sci.ak by discipline prefix. apex `science` → field → item.

def "science" "Science — the disciplines of empirical knowledge and their history: how the world was measured, and how the measuring itself came to be. The apex of the sciences field."
def "sci:field:archaeoastronomy" "Archaeoastronomy — how ancient peoples watched and built to the sky."
ln sci:field:archaeoastronomy science sys:is_a
def "sci:field:astronomy" "Astronomy — the science and history of the heavens."
ln sci:field:astronomy science sys:is_a
def "sci:field:biology" "Biology — the science of living things."
ln sci:field:biology science sys:is_a
def "sci:field:culinary_science" "Culinary science — the chemistry and craft of cooking."
ln sci:field:culinary_science science sys:is_a
def "sci:field:geoscience" "Geoscience — the earth, its stone, water, and weather."
ln sci:field:geoscience science sys:is_a
def "sci:field:history_of_science" "History of science — how knowledge itself was made."
ln sci:field:history_of_science science sys:is_a

