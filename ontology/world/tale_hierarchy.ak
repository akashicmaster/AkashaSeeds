# tale_hierarchy.ak — a browsable sys:is_a taxonomy over the flat tale: namespace, so
# the archives field navigator (分野別) can show a left hierarchy for the Tale Room.
# Generated from ontology/world/tale.ak by prefix (fabulist / collection). apex `tale` →
# collection → each tale. Additive: only adds a def apex + collection defs + sys:is_a.

def "tale" "Tale — the world's told stories: fables, folktales, and the early scientific romances, grouped by tradition and teller. The apex of the tale field."
def "tale:col:aesop" "Aesop's fables — 44 tales in the collection."
ln tale:col:aesop tale sys:is_a
def "tale:col:anansi" "The Anansi tales — 7 tales in the collection."
ln tale:col:anansi tale sys:is_a
def "tale:col:arabian" "The Arabian Nights — 6 tales in the collection."
ln tale:col:arabian tale sys:is_a
def "tale:col:china" "Chinese tales — 16 tales in the collection."
ln tale:col:china tale sys:is_a
def "tale:col:grimm" "Grimm's tales — 16 tales in the collection."
ln tale:col:grimm tale sys:is_a
def "tale:col:japan" "Japanese tales — 9 tales in the collection."
ln tale:col:japan tale sys:is_a
def "tale:col:jataka" "The Jataka tales — 26 tales in the collection."
ln tale:col:jataka tale sys:is_a
def "tale:col:kancil" "The Kancil (mouse-deer) tales — 7 tales in the collection."
ln tale:col:kancil tale sys:is_a
def "tale:col:lafontaine" "La Fontaine's fables — 33 tales in the collection."
ln tale:col:lafontaine tale sys:is_a
def "tale:col:nasreddin" "The Nasreddin tales — 14 tales in the collection."
ln tale:col:nasreddin tale sys:is_a
def "tale:col:native" "Native American tales — 7 tales in the collection."
ln tale:col:native tale sys:is_a
def "tale:col:panchatantra" "The Panchatantra — 31 tales in the collection."
ln tale:col:panchatantra tale sys:is_a
def "tale:col:scientific_romance" "Scientific romance (early science fiction) — 60 tales in the collection."
ln tale:col:scientific_romance tale sys:is_a

