  "_evals": "The platform's own evals — the enforcement and conformance suite and the heart's laws. With the platform packages' `evals` globs they are the test files PLATFORM_TREE.json covers (the purge order §4.3); every other test file is an application's.",
  "env": {
    "AKASHA_DATA_DIR": {
      "kind": "path",
      "default": "<root>/data",
      "means": "the cell's data directory"
    },
    "AKASHA_APP_DIR": {
      "kind": "path",
      "default": "<root>/app",
      "means": "the application root — everything the application provides lives under it (platform-spec v1)"
    },
    "AKASHA_BASE_DIR": {
      "kind": "path",
      "default": "data",
      "means": "the data directory the gate binds when no kernel has bound it (a process with no launcher)"
    },
    "AKASHA_PROJECT_DIR": {
      "kind": "path",
      "default": "<root>",
      "means": "the project root the ontology and its config are read from"
    },
    "AKASHA_SOURCE_PACK_DIR": {
      "kind": "path",
      "default": "<app root>/assets",
      "means": "where the application's source packs (corpus bundles) are read from"
    },
    "AKASHA_SNAPSHOT_DIR": {
      "kind": "path",
      "default": "<pages root>/snapshots",
      "means": "the portal's disk snapshot store"
    },
    "AKASHA_TLS_CERT": {
      "kind": "path",
      "default": "",
      "means": "an operator-supplied certificate (fullchain PEM); ACME manages none when set"
    },
    "AKASHA_TLS_KEY": {
      "kind": "path",
      "default": "",
      "means": "the private key for AKASHA_TLS_CERT"
    },
    "AKASHA_HOST": {
      "kind": "network",
      "default": "(the launcher's --host)",
      "means": "the address the portal binds"
    },
    "AKASHA_PORT": {
      "kind": "network",
      "default": "(the launcher's --port)",
      "means": "the port the portal binds"
    },
    "AKASHA_HTTPS_PORT": {
      "kind": "network",
      "default": "443",
      "means": "the HTTPS port when TLS is active"
    },
    "AKASHA_BASE_DOMAIN": {
      "kind": "network",
      "default": "",
      "means": "the public domain (host routing; the ACME fallback domain)"
    },
    "AKASHA_TLS_DOMAINS": {
      "kind": "network",
      "default": "",
      "means": "the certificate's domains (comma-separated)"
    },
    "AKASHA_TLS_EMAIL": {
      "kind": "network",
      "default": "",
      "means": "the ACME contact address"
    },
